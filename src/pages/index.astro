---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChapterSignature from '../components/ChapterSignature.astro';
import egLogo from '../assets/eg-logo.svg';
import departure from '../assets/Sokolov-2_Nano Banana 2.1_2026-11-06_19-27-59.png';
import learn from '../assets/Sokolov-2_Nano Banana 2.1_2026-11-06_19-33-37.png';
import build from '../assets/Sokolov-2_Nano Banana 2.1_2026-11-06_19-41-19.png';
import ascent from '../assets/Sokolov-2_Nano Banana 2.1_2026-11-06_19-53-19.png';
import cycling from '../assets/Sokolov-2_Nano Banana 2.1_2026-11-06_19-57-23.png';
import meeting from '../assets/Sokolov-2_Nano Banana 2.1_2026-11-06_20-19-01.png';

const chapters = [
  {
    id: 'start', name: 'Начало', image: departure, alt: 'Евгений шагает по извилистой каменной тропе',
    title: 'Я Евгений Григорьев',
    paragraphs: [
      'Бизнес-архитектор, инвестор, эксперт по AI и цифровой трансформации',
      'Любопытство помогает мне находить закономерности, разбираться в сложных системах и видеть возможности для их развития.',
    ],
    ground: '#d7e4ea',
  },
  {
    id: 'curiosity', name: 'Любопытство', image: learn, alt: 'Персонаж сидит на каменной ступени и изучает чертёж',
    title: 'Вижу систему. Запускаю изменения',
    paragraphs: [
      'Выстраиваю архитектуру компаний и определяю, как AI повышает производительность, сокращает затраты и создает новые возможности для компаний с оборотом от 2 млрд ₽.',
      'Разработал <strong>подход к управлению состоянием компании</strong>: на основе данных в моменте принимать решения.',
    ],
    ground: '#d5dfe7',
  },
  {
    id: 'creation', name: 'Созидание', image: build, alt: 'Евгений собирает модель моста на каменном рабочем столе',
    title: 'Идеям нужны живые проекты',
    paragraphs: [
      '30+ кейсов трансформации компаний.',
      'Цифровизация Росстата с бюджетом 2+ млрд.',
      'Модератор и эксперт бизнес-школы Сколково. Собственные курсы в МАИ, МГУ и РАНХиГС.',
    ],
    ground: '#dbe5e5',
  },
  {
    id: 'ascent', name: 'Подъём', image: ascent, alt: 'Персонаж с рюкзаком и треккинговой палкой поднимается по крутому горному склону',
    title: 'Большое шаг за шагом.',
    paragraphs: [
      'Основал DT-Team и вместе с командой работаю над задачами цифрового развития и трансформации компаний.',
      'Партнер Lithium.',
    ],
    link: 'Открыть DT-Team', href: 'https://dt-team.ru/', ground: '#d4dfe9',
  },
  {
    id: 'momentum', name: 'Движение', image: cycling, alt: 'Персонаж едет на бирюзовом велосипеде по холмистой дороге',
    title: 'Любопытство помогает идеям расти',
    paragraphs: [
      'Партнер FriendlyFC',
      'Инвестирую в технологические проекты, провожу M&A сделки.',
      'Среди проектов: GPUAudio, Base-Track, XDAO и AL-Technologies.',
    ],
    ground: '#dce7ec',
  },
  {
    id: 'conversation', name: 'Знакомство', image: meeting, alt: 'Персонаж с чашкой кофе на каменной скамье под оливковым деревом; рядом свободное место',
    title: 'Мир полон идей',
    paragraphs: [
      'Обсудить трансформацию вашей компании: <a href="https://t.me/GrigorevEugene" target="_blank" rel="noopener noreferrer">написать в Telegram</a>.',
      'Пригласить спикером на мероприятие: <a href="https://t.me/GrigorevEugene" target="_blank" rel="noopener noreferrer">заполнить бриф</a>.',
    ],
    ground: '#d2dde5',
  },
];
---
<BaseLayout title="Евгений Григорьев — бизнес-архитектор, инвестор, эксперт по AI" description="Бизнес-архитектор, инвестор, эксперт по AI и цифровой трансформации. Опыт Евгения Григорьева, проекты и подход к управлению состоянием компании.">
  <header class="site-header">
    <a class="wordmark" href="#start" aria-label="Евгений Григорьев — к началу">
      <img src={egLogo.src} width="64" height="54" alt="EG" />
    </a>
  </header>
  <main id="main" tabindex="-1">
    <div class="journey scene is-rest" data-scene="journey" aria-label="Путь Евгения Григорьева">
      <div class="journey-stage">
        {chapters.map((chapter, index) => (
          <section id={chapter.id} class={`chapter chapter--${chapter.id}`} style={`--chapter-ground: ${chapter.ground}`} aria-labelledby={`${chapter.id}-title`} data-chapter={index}>
            <ChapterSignature />
            <div class="chapter-copy">
              {index === 0
                ? <h1 id={`${chapter.id}-title`}>{chapter.title}</h1>
                : <h2 id={`${chapter.id}-title`}>{chapter.title}</h2>}
              {chapter.paragraphs.map((paragraph, paragraphIndex) => (
                <p class={index === 0 && paragraphIndex > 0 ? 'chapter-note' : 'chapter-text'} set:html={paragraph} />
              ))}
              {chapter.link && <a class="text-link" href={chapter.href} target="_blank" rel="noopener noreferrer">{chapter.link}</a>}
            </div>
            <figure class="chapter-art">
              <img src={chapter.image.src} width={chapter.image.width} height={chapter.image.height} alt={chapter.alt} loading="eager" fetchpriority={index === 0 ? 'high' : 'auto'} decoding="async" />
            </figure>
            {index === chapters.length - 1 && (
              <footer class="chapter-footer">
                <a href={`${import.meta.env.BASE_URL}policy/`}>Конфиденциальность</a>
              </footer>
            )}
          </section>
        ))}
        <div class="journey-controls">
          <span class="chapter-status">© 2021–2026.<span class="copyright-rights"> Все права защищены.</span></span>
          <nav class="chapter-dots" aria-label="Перейти к главе">{chapters.map((chapter, i) => <a href={`#${chapter.id}`} aria-label={chapter.name} aria-current={i === 0 ? 'step' : undefined}><span></span></a>)}</nav>
          <p class="design-credit"><span>Идея и дизайн</span>{' '}<a href="https://noisybrands.ru/" target="_blank" rel="noopener noreferrer">noisybrands</a></p>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
<script>
  import { initMotion } from '../scripts/motion';
  initMotion();
</script>
